✅ 6) Trigger (Audit Table)

CREATE TABLE Student_Log (
    log_id INT IDENTITY(1,1),
    message VARCHAR(100),
    log_date DATETIME
);

CREATE TRIGGER trg_student_insert
ON Student
AFTER INSERT
AS
BEGIN
    INSERT INTO Student_Log(message, log_date)
    SELECT 'Inserted Student ID: ' + CAST(id AS VARCHAR),
           GETDATE()
    FROM inserted;
END;


