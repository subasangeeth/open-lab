✅ 11) Report Query (Advanced)

SELECT d.dept_name,
COUNT(s.id) AS total_students,
MAX(s.marks) AS highest,
MIN(s.marks) AS lowest,
AVG(s.marks) AS average
FROM Student s
JOIN Department d ON s.dept_id = d.dept_id
GROUP BY d.dept_name;


