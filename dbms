✅ 4) Cursor + Procedure + Function (Advanced)

Cursor

DECLARE @id INT, @marks INT;

DECLARE student_cursor CURSOR FOR
SELECT id, marks FROM Student;

OPEN student_cursor;

FETCH NEXT FROM student_cursor INTO @id, @marks;

WHILE @@FETCH_STATUS = 0
BEGIN
    PRINT 'ID: ' + CAST(@id AS VARCHAR) +
          ' Marks: ' + CAST(@marks AS VARCHAR);

    FETCH NEXT FROM student_cursor INTO @id, @marks;
END;

CLOSE student_cursor;
DEALLOCATE student_cursor;


