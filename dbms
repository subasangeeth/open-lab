Procedure with Parameter

CREATE PROCEDURE GetTopStudents
@minMarks INT
AS
BEGIN
    SELECT * FROM Student
    WHERE marks >= @minMarks;
END;

EXEC GetTopStudents 85;


---

Function with Condition

CREATE FUNCTION GetAvgMarks(@dept INT)
RETURNS FLOAT
AS
BEGIN
    DECLARE @avg FLOAT;

    SELECT @avg = AVG(marks)
    FROM Student
    WHERE dept_id = @dept;

    RETURN @avg;
END;

SELECT dbo.GetAvgMarks(1);


